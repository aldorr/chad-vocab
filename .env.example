# App
PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string
INVITE_CODE=

# Paths (relative to repo root or absolute)
DATABASE_PATH=./data/vocab.db
AUDIO_DIR=./data/audio

# Scriberr (local Whisper frontend) — create an API key in the Scriberr UI
SCRIBERR_URL=http://127.0.0.1:8080
SCRIBERR_API_KEY=
# WhisperX on CPU can take minutes; wait up to 4 minutes by default
SCRIBERR_TIMEOUT_MS=240000
SCRIBERR_POLL_MS=1000
# Hints for faster jobs (Scriberr may ignore unknown fields)
SCRIBERR_MODEL=tiny
SCRIBERR_MODEL_FAMILY=whisper

# LM Studio — start the local server; we auto-load LM_STUDIO_MODEL when needed
LM_STUDIO_URL=http://127.0.0.1:1234/v1
# Substring match against downloaded models (e.g. gemma, google/gemma-3-4b)
LM_STUDIO_MODEL=gemma

# Each user picks cue + answer languages in the UI (defaults: German → Spanish)
